{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/login.html"
    },
    {
      "source": "/orcamento",
      "destination": "/orcamento.html"
    },
    {
      "source": "/sucesso",
      "destination": "/sucesso.html"
    }
  ]
}
